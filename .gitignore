/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — broad by design. A file named .env.staging or
# .env.something was NOT covered by the old explicit list, which is exactly
# how a service_role key ends up in a public repo.
.env
.env*
!.env.example
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local Claude Code tool config — machine-specific, never commit
.claude/
