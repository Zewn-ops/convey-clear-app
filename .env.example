# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin invite token (used to identify admin signups - change this before production)
ADMIN_INVITE_TOKEN=changeme-before-production

# 🔒 Council portal credential encryption (migration 074)
# AES-256 key, base64, for encrypting the council logins firms enter for their
# staff. Generate with:  openssl rand -base64 32
# Set in Vercel env AND .env.local. Back it up in Vaultwarden — losing it makes
# every stored council login unrecoverable, and they must be re-entered.
# Without it the credentials feature refuses to save rather than storing
# plaintext.
COUNCIL_CRED_KEY=
