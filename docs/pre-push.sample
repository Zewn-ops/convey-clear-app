#!/usr/bin/env bash
# Mirror every GitHub push to the Gitea remote on the NUC.
#
# Standing rule, 2026-08-27: Gitea is the self-hosted copy of record and had
# drifted 85 commits behind GitHub because mirroring was a thing someone had to
# remember. Now it is not.
#
# Fires only when the push target is `github`; a push to `origin` (Gitea itself)
# skips, so this never recurses.
#
# Runs BEFORE the GitHub push completes — git has no post-push hook. So Gitea can
# briefly end up AHEAD of GitHub if the GitHub push is then rejected. That is the
# harmless direction for a backup mirror, and the next successful push settles it.
# Never blocks: a NUC that is asleep or off the LAN must not stop you shipping.

remote="$1"
[ "$remote" = "github" ] || exit 0
git remote get-url origin >/dev/null 2>&1 || exit 0

refs=()
while read -r local_ref _ _ _; do
  [ -n "$local_ref" ] && [ "$local_ref" != "(delete)" ] && refs+=("${local_ref#refs/heads/}")
done

[ ${#refs[@]} -eq 0 ] && exit 0

echo "→ mirroring to Gitea: ${refs[*]}"
if timeout 60 git push --quiet origin "${refs[@]}" 2>/dev/null; then
  echo "  Gitea updated."
else
  echo "  ⚠ Gitea mirror FAILED (NUC unreachable?) — run 'git push origin ${refs[*]}' when back on the LAN."
fi
exit 0
